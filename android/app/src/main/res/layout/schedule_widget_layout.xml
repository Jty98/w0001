<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_nav_button_bg"
            android:contentDescription="이전 주"
            android:padding="6dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#2259D4" />

        <TextView
            android:id="@+id/widget_week_title"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_week_title_bg"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="26.04.22-26.04.28"
            android:textColor="#2259D4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widget_btn_reset"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_nav_button_bg"
            android:contentDescription="이번 주"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:tint="#2259D4" />

        <ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_nav_button_bg"
            android:contentDescription="다음 주"
            android:padding="6dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="#2259D4" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#D1DBF4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E8F0FF"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:text="등록된 일정이 없습니다."
            android:textColor="#35415A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="#35415A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
